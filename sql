
-- ==========================================
-- 1. MEMBUAT TABEL MAKANAN
-- ==========================================

CREATE TABLE IF NOT EXISTS public.makanan (
    id_makanan BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nama_makanan TEXT NOT NULL,
    harga NUMERIC(12,2) NOT NULL CHECK (harga >= 0)
);


-- ==========================================
-- 2. MENGAKTIFKAN RLS
-- ==========================================

ALTER TABLE public.makanan ENABLE ROW LEVEL SECURITY;


-- ==========================================
-- 3. POLICY SELECT / MENAMPILKAN DATA
-- ==========================================

CREATE POLICY "select_makanan"
ON public.makanan
FOR SELECT
TO anon
USING (true);


-- ==========================================
-- 4. POLICY INSERT / MENAMBAHKAN DATA
-- ==========================================

CREATE POLICY "insert_makanan"
ON public.makanan
FOR INSERT
TO anon
WITH CHECK (true);


-- ==========================================
-- 5. POLICY UPDATE / MENGEDIT DATA
-- ==========================================

CREATE POLICY "update_makanan"
ON public.makanan
FOR UPDATE
TO anon
USING (true)
WITH CHECK (true);


-- ==========================================
-- 6. POLICY DELETE / MENGHAPUS DATA
-- ==========================================

CREATE POLICY "delete_makanan"
ON public.makanan
FOR DELETE
TO anon
USING (true);
