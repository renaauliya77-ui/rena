
/* =====================================
   RESET & DASAR
===================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #1e293b;
    min-height: 100vh;
}

/* =====================================
   HEADER
===================================== */

header {
    background: linear-gradient(135deg, #0f172a, #1e3a8a, #2563eb);
    color: white;
    padding: 30px 7%;
    box-shadow: 0 5px 20px rgba(15, 23, 42, 0.15);
}

header h1 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

header p {
    margin-top: 8px;
    font-size: 14px;
    color: #dbeafe;
}

/* =====================================
   CONTAINER
===================================== */

.container {
    width: 90%;
    max-width: 1200px;
    margin: 35px auto;
}

/* =====================================
   STATISTIK DASHBOARD
===================================== */

.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 25px;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
    transition: 0.3s;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.10);
}

.stat-card h3 {
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 12px;
}

.stat-card p {
    color: #2563eb;
    font-size: 28px;
    font-weight: 700;
}

/* =====================================
   CARD
===================================== */

.card {
    background: white;
    padding: 28px;
    border-radius: 16px;
    margin-bottom: 25px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
}

.card h2 {
    font-size: 21px;
    margin-bottom: 22px;
    color: #0f172a;
}

/* =====================================
   FORM
===================================== */

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

label {
    display: block;
    margin-bottom: 9px;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

input {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #ffffff;
    font-size: 14px;
    color: #1e293b;
    transition: 0.2s;
}

input::placeholder {
    color: #94a3b8;
}

input:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.10);
}

/* =====================================
   BUTTON
===================================== */

.form-actions {
    margin-top: 22px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

button {
    border: none;
    padding: 12px 18px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
}

button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
}

button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.btn-primary {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.20);
}

.btn-primary:hover {
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.30);
}

.btn-secondary {
    background: #64748b;
    color: white;
}

.btn-edit {
    background: #f59e0b;
    color: white;
    padding: 9px 13px;
}

.btn-delete {
    background: #ef4444;
    color: white;
    padding: 9px 13px;
}

/* =====================================
   SEARCH
===================================== */

.search-box {
    max-width: 380px;
    margin-bottom: 20px;
}

/* =====================================
   TABLE
===================================== */

.table-wrapper {
    overflow-x: auto;
    border-radius: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

thead {
    background: #eff6ff;
}

th {
    padding: 16px;
    text-align: left;
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 700;
    border-bottom: 1px solid #dbeafe;
}

td {
    padding: 15px 16px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
    font-size: 14px;
}

tbody tr {
    transition: 0.2s;
}

tbody tr:hover {
    background: #f8fafc;
}

tbody tr:last-child td {
    border-bottom: none;
}

/* =====================================
   ACTIONS
===================================== */

.actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

/* =====================================
   STATUS
===================================== */

.status {
    display: none;
    padding: 14px 16px;
    margin-bottom: 18px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
}

.status.success {
    display: block;
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
}

.status.error {
    display: block;
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
}

.status.info {
    display: block;
    background: #dbeafe;
    color: #1e40af;
    border: 1px solid #bfdbfe;
}

/* =====================================
   EMPTY DATA
===================================== */

.empty {
    text-align: center;
    color: #94a3b8;
    padding: 35px !important;
}

/* =====================================
   RESPONSIVE MOBILE
===================================== */

@media screen and (max-width: 768px) {

    header {
        padding: 25px 5%;
    }

    header h1 {
        font-size: 24px;
    }

    .container {
        width: 94%;
        margin: 22px auto;
    }

    .stats {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .form-grid {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .card {
        padding: 20px;
    }

    .card h2 {
        font-size: 19px;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions button {
        width: 100%;
    }

    .actions {
        flex-direction: column;
        align-items: stretch;
    }

    .actions button {
        width: 100%;
    }
}

/* =====================================
   RESPONSIVE SMALL SCREEN
===================================== */

@media screen and (max-width: 480px) {

    header h1 {
        font-size: 21px;
    }

    header p {
        font-size: 12px;
    }

    .stat-card p {
        font-size: 24px;
    }

    .card {
        padding: 16px;
        border-radius: 12px;
    }

    input {
        padding: 11px;
    }

    button {
        padding: 11px;
    }
}
